# Copy to .env and fill in real values. Never commit .env.
# Loaded by app/config/config.php (vlucas/phpdotenv) from the backend root.

# Database (MariaDB)
DB_HOST=localhost
DB_NAME=blogdotdb
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# JWT (HS256)
JWT_SECRET=change_me_to_a_long_random_string
# token lifetime in seconds
JWT_EXPIRATION=3600

# Seconds between "delete account" and the hard delete done by the delete_users DB event
USER_DELETION_DELAY=7200

# Maze (native OpenSSL, see docs/maze_deployment.md)
MAZE_ADMIN_USERNAME="admin"
MAZE_PRIVATE_KEY_PATH="/absolute/path/to/blog.backend/.maze_private_key.asc"
MAZE_PASSPHRASE="your_private_key_passphrase"
# Plaintext sent back encrypted to users who finish the maze (RSA-OAEP: keep it under ~200 bytes)
MAZE_BONUS_MESSAGE="your_bonus_message"
